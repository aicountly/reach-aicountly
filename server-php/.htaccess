RewriteEngine On
RewriteBase /api/

# cPanel: composer.json requires PHP ^8.2 — keep this on the ea-php82 handler
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>

# Pass Authorization header to PHP (required for JWT on Apache/CGI/FPM)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# .well-known stays reachable for ACME/AutoSSL certificate validation.
RewriteRule ^\.well-known/ - [L]

# Block direct access to sensitive paths (named explicitly; the front-controller
# rule below already 404s any other real file or directory).
RewriteRule ^(app|database|writable|vendor|content-base|tests|scripts|bin)/ - [F,L]

# Only the front controller answers. Every other real file or directory here
# (composer.json/.lock, spark, phpunit.xml.dist, REVISION, the deploy's
# cpanel-post-deploy-api.sh, public/, a PHP error_log) would otherwise be served
# as source, or run as PHP against the live .env, so anything real that is not
# index.php is a 404. Media is served by the v1/public/media route, not as files.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule !^(index\.php)?$ - [R=404,L]

# Everything else goes to the CodeIgniter front controller. No /$1: the router
# reads REQUEST_URI, and appending it would re-trigger the 404 rule above.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<FilesMatch "^\.env">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# --- Refuse at any depth, inherited by nested directories ---------------------
# RedirectMatch (mod_alias) is inherited even where a nested .htaccess replaces
# the mod_rewrite rules above, so these still apply.

# PHP's error_log (DB errors, filesystem paths, stack-trace arguments) at any depth.
RedirectMatch 404 (^|/)error_log$

# Dotfiles at any depth (.env, .env.*, .git, .gitignore, .htaccess), except
# .well-known which ACME/AutoSSL needs.
RedirectMatch 404 /\.(?!well-known)
