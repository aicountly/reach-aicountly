RewriteEngine On
RewriteBase /api/

# cPanel: composer.json requires PHP ^8.2 — keep this on the ea-php82 handler
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>

# Pass Authorization header to PHP (required for JWT on Apache/CGI/FPM)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Block direct access to sensitive paths
RewriteRule ^(app|database|writable|vendor|content-base)/ - [F,L]

<FilesMatch "^\.env">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
