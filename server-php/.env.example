# AICOUNTLY Reach Marketing Portal API (CodeIgniter 4.6)
# Copy to .env locally; never commit a real .env.

CI_ENVIRONMENT=production
app.baseURL=https://reach.aicountly.org/api/
app.indexPage=

# --- PostgreSQL (Reach marketing DB — never target other portal DBs) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=aicountly_reach
DB_USER=
DB_PASS=

# --- Independent superadmin auth (Reach only; not linked to my.aicountly.com) ---
# Generate: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
JWT_SECRET=
JWT_TTL_MINUTES=720

# --- CORS — comma-separated origins allowed to call this API ---
ALLOWED_ORIGINS=https://reach.aicountly.org,http://localhost:5173

# --- Seed superadmin (InitialReachSeeder; quote values that contain spaces) ---
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME="Reach Superadmin"
SUPER_ADMIN_PASSWORD=

# --- Reach Marketing Bot ---
# DB row reach_bot_settings.mode is authoritative; this env value is used
# only as a fallback when the settings row is missing.
REACH_BOT_MODE=confirm
REACH_BOT_OPENAI_KEY=
REACH_BOT_ANTHROPIC_KEY=

# --- Console controller SSO (Top Controller identity provider) ---
CONSOLE_API_URL=https://console.aicountly.org/api
CONTROLLER_APP_CODE=reach

# --- Console fan-out (Flow pattern: POST /audit with typed events) ---
CONSOLE_API_BASE_URL=https://console.aicountly.org/api
CONSOLE_API_TOKEN=

# --- Editorial notifications (SMS/email via Console gateways) ---
# Templates: Console → Communications → Notification Triggers (product: reach)
# Gateways live on Console server .env (EMAIL_API_KEY, SMS_API_KEY, etc.)
# Reach only needs CONSOLE_API_BASE_URL + CONSOLE_API_TOKEN above.
REACH_APP_URL=https://reach.aicountly.org

# --- Inbound from Console (portal/bot/* endpoints) ---
# Console must send this value in the `X-Console-Token` header.
CONSOLE_INBOUND_TOKEN=

# --- Engage lead push (real endpoint on engage.aicountly.org) ---
# The lead endpoint expects header `X-Portal-Token: <ENGAGE_INBOUND_TOKEN>`.
ENGAGE_API_BASE_URL=https://engage.aicountly.org/api/v1
ENGAGE_INBOUND_TOKEN=

# --- Playwright worker (worker.apis.aicountly.com) ---
# The client degrades gracefully if the endpoints or token are missing.
WORKER_BASE_URL=https://worker.apis.aicountly.com
WORKER_API_TOKEN=

# --- Phase 4: AICOUNTLY.com public-site publishing connector ---
# All values come from environment only; never stored in the database.
# AICOUNTLY_PUBLIC_SITE_BASE_URL  — Base URL of the public site (no trailing slash)
# AICOUNTLY_PUBLIC_SITE_SERVICE_TOKEN — Bearer credential included in Authorization header
# AICOUNTLY_PUBLIC_SITE_SIGNING_KEY   — HMAC-SHA256 secret for request signature
# AICOUNTLY_PUBLIC_SITE_KEY_ID        — Key identifier sent in X-Reach-Key-Id header
# AICOUNTLY_PUBLIC_SITE_TIMEOUT       — HTTP timeout in seconds (default 15)
# AICOUNTLY_PUBLIC_SITE_API_VERSION   — Contract version sent in X-Reach-API-Version (default 1)
# REACH_PUB_MOCK                      — Set to "true" to force MockPublicSitePublisher in all environments
AICOUNTLY_PUBLIC_SITE_BASE_URL=https://aicountly.com
AICOUNTLY_PUBLIC_SITE_SERVICE_TOKEN=
AICOUNTLY_PUBLIC_SITE_SIGNING_KEY=
AICOUNTLY_PUBLIC_SITE_KEY_ID=reach-v1
AICOUNTLY_PUBLIC_SITE_TIMEOUT=15
AICOUNTLY_PUBLIC_SITE_API_VERSION=1
REACH_PUB_MOCK=false

# --- Community Q&A automation ---
# Off by default. When on, only risk tier 0/1 answers (product usage, general
# education) auto-approve and publish; tier 2/3 (GST, income tax, company law,
# payroll — i.e. most compliance questions) still require a human approval in
# Reach, and tier 4 is never publishable. `php spark community:advance` is the
# cron that routes drafts either way, so leaving this off does not stall the
# pipeline — it parks answers in the human review queue instead.
COMMUNITY_AUTO_PUBLISH_ENABLED=false
# Set to "true" to force MockCommunityPublisher (no calls to aicountly.com).
REACH_PUB_COMMUNITY_MOCK=false

# Legacy placeholders — superseded by AICOUNTLY_PUBLIC_SITE_* above
AICOUNTLY_SITE_API_BASE_URL=
AICOUNTLY_SITE_API_TOKEN=

# --- Social channel provider tokens (empty = manual posting queue) ---
LINKEDIN_API_TOKEN=
TWITTER_API_TOKEN=
FACEBOOK_API_TOKEN=
INSTAGRAM_API_TOKEN=
YOUTUBE_API_TOKEN=
WHATSAPP_CHANNEL_API_TOKEN=

# --- GA4 Traffic Analytics (ported from Flow — configure on server api/.env only) ---
# Marketing site (aicountly.com)
GA4_PROPERTY_ID_MARKETING=
GOOGLE_SERVICE_ACCOUNT_JSON_MARKETING=
# Reach portal (reach.aicountly.org) — falls back to GA4_PROPERTY_ID_PORTAL if unset
GA4_PROPERTY_ID_REACH=
GOOGLE_SERVICE_ACCOUNT_JSON_REACH=
GA4_PROPERTY_ID_PORTAL=
GOOGLE_SERVICE_ACCOUNT_JSON_PORTAL=
# Shared my.aicountly.com SaaS hub property (pagePath filters per product when no dedicated property)
GA4_PROPERTY_ID_SAAS=
GOOGLE_SERVICE_ACCOUNT_JSON_SAAS=
AICOUNTLY_SITE_URL=https://www.aicountly.com
AIC_GLOBAL_URL=https://my.aicountly.com
REACH_APP_URL=https://reach.aicountly.org
# Per-product GA4 (optional — copy from Flow .env.ga4.example, e.g. GA4_PROPERTY_ID_SAAS_SMART_BOOKS)
# GA4_PROPERTY_ID_SAAS_SMART_BOOKS=
# GOOGLE_SERVICE_ACCOUNT_JSON_SAAS_SMART_BOOKS=

# --- Phase 8: Search Intelligence, Attribution and AI Visibility ---

# Google Search Console connector
SEARCH_CONSOLE_ENABLED=false
SEARCH_CONSOLE_PROPERTY=
# Credential reference (path to service-account JSON or Secret Manager ref — never raw JSON)
SEARCH_CONSOLE_CREDENTIAL_REFERENCE=
SEARCH_CONSOLE_BACKFILL_DAYS=90
SEARCH_CONSOLE_BATCH_SIZE=25000

# Live connector (GoogleSearchConsoleConnector). Absolute path to the
# service-account JSON, readable by the web and CLI users and stored outside the
# document root. The service account must be added as a user on the property.
SEARCH_CONSOLE_SERVICE_ACCOUNT_KEY_PATH=
# Exact property string as it appears in Search Console,
# e.g. sc-domain:aicountly.com or https://aicountly.com/
SEARCH_CONSOLE_SITE_PROPERTY=
# Search Console finalises data on a lag; never ingest days newer than this.
SEARCH_CONSOLE_DATA_LAG_DAYS=3
SEARCH_CONSOLE_TIMEOUT_SECONDS=30
# Force the mock connector even when credentials exist (local development only).
SEARCH_CONSOLE_USE_MOCK=false

# Content Analytics connector (GA4 per-content). Live connector is
# GoogleAnalyticsContentConnector — honest DISABLED/MISCONFIGURED states are
# reported when unset; never falls back to mock data outside tests.
CONTENT_ANALYTICS_ENABLED=false
CONTENT_ANALYTICS_PROVIDER=ga4
# GA4 property ID for per-content analytics (numeric GA4 property ID, not "G-XXXX")
CONTENT_ANALYTICS_PROPERTY_ID=
CONTENT_ANALYTICS_CREDENTIAL_REFERENCE=
# Absolute path to the service-account JSON, readable by web and CLI users,
# stored outside the document root. The service account must have Viewer
# access on the GA4 property.
CONTENT_ANALYTICS_SERVICE_ACCOUNT_KEY_PATH=
CONTENT_ANALYTICS_TIMEOUT_SECONDS=30
CONTENT_ANALYTICS_BACKFILL_DAYS=90
# Force the mock connector even when credentials exist (local development only).
CONTENT_ANALYTICS_USE_MOCK=false

# IndexNow
INDEXNOW_ENABLED=false
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
# API key reference — never commit the actual key
INDEXNOW_KEY_REFERENCE=
# Public URL where the key file is served (e.g. https://yourdomain.com/<key>.txt)
INDEXNOW_KEY_LOCATION=
INDEXNOW_BATCH_SIZE=100

# AI Visibility monitoring
# Reuses existing AI provider registry — no new credentials required
# Maximum execution budget per visibility run (cents)
VISIBILITY_MAX_BUDGET_CENTS=1000

# --- Campaign distribution gateways (Phase 7 — direct send from Reach) ---
# Email via Itwalk / Infobip (multipart for /email/1/send)
EMAIL_PROVIDER=itwalk
EMAIL_API_KEY=
EMAIL_API_URL=https://e.api.itwalk.in/email/1/send
EMAIL_API_FORMAT=multipart
SENDER_EMAIL=support@aicountly.com
SENDER_NAME="AICOUNTLY Reach"
# Fallback recipient when campaign audience is not resolved yet
CAMPAIGN_DISPATCH_TEST_EMAIL=

# SMS via Digimiles / AOC Portal
SMS_PROVIDER=aoc-portal
SMS_API_URL=https://api.aoc-portal.com/v1/sms
SMS_API_KEY=
SMS_SENDER_ID=AICTLY
SMS_TYPE=TRANS
SMS_COUNTRY_CODE=91
SMS_SKIP_SEND=false
CAMPAIGN_DISPATCH_TEST_PHONE=

# WhatsApp via Infobip-style API
WHATSAPP_PROVIDER=infobip
WHATSAPP_API_KEY=
WHATSAPP_WABA_ID=
WHATSAPP_SENDER_ID=
WHATSAPP_SKIP_SEND=false

# --- Legacy provider placeholders (Reach UI uses GA4 streams above) ---
GSC_SITE_URL=
META_ACCESS_TOKEN=
LINKEDIN_ANALYTICS_TOKEN=
TWITTER_ANALYTICS_TOKEN=
YOUTUBE_ANALYTICS_TOKEN=
EMAIL_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=

# --- Public lead-capture token (used by embeddable landing/form widgets) ---
# Rotate periodically. Empty disables the public /v1/public/leads/capture route.
PUBLIC_LEAD_CAPTURE_TOKEN=

# --- Rate-limit proxy handling ---
# Comma-separated IP list. When the immediate peer matches, RateLimitFilter
# will use the first entry of the X-Forwarded-For header as the client IP.
# Leave empty on cPanel unless a load balancer is proven trusted.
TRUSTED_PROXIES=

# --- Correlation IDs ---
# Optional prefix stamped onto generated request IDs (helps distinguish sources
# when correlating logs across Reach/Console/worker/engage).
# Example: reach-prod, reach-staging.
REACH_REQUEST_ID_PREFIX=

# --- Blog automation feature flags (Phase 2+) ---
BLOG_COMMAND_CENTRE_ENABLED=true
BLOG_LEGACY_CREATE_DISABLED=true
BLOG_LEGACY_REDIRECT_ENABLED=true
BLOG_AUTOMATION_ENABLED=false
BLOG_ROADMAP_OPTIMIZER_ENABLED=false
BLOG_AI_GENERATION_ENABLED=false
BLOG_FACT_VERIFICATION_ENABLED=false
BLOG_IMAGE_GENERATION_ENABLED=false
BLOG_AUTO_PUBLISH_ENABLED=false
BLOG_FILE_RENDERING_ENABLED=false
BLOG_DB_BODY_FALLBACK_ENABLED=true
BLOG_PUBLIC_PUBLISHER_ENABLED=false
BLOG_SEARCH_CONSOLE_ENABLED=false
BLOG_GA4_ENABLED=false

# --- Blog AI providers (keys are read from the environment only, never the DB) ---
# Leaving a key blank keeps that adapter permanently inactive.
# OpenAI is the default primary draft provider — its key is REQUIRED for the
# API blog route. Text models are seeded into the catalog from the
# *_DEFAULT_MODEL values by `php spark reach:ai-seed-catalog`.
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_DEFAULT_MODEL=gpt-5-mini

AI_GEMINI_API_KEY=
AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_GEMINI_DEFAULT_MODEL=gemini-2.5-flash
# Cover images: "Nano Banana Pro"; falls back automatically when unavailable.
AI_GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
AI_GEMINI_IMAGE_FALLBACK_MODEL=gemini-2.5-flash-image

AI_PERPLEXITY_API_KEY=
AI_PERPLEXITY_BASE_URL=https://api.perplexity.ai
AI_PERPLEXITY_DEFAULT_MODEL=sonar-pro
# Perplexity has no free models endpoint; live health checks cost tokens.
AI_PERPLEXITY_HEALTHCHECK_ALLOW_SPEND=false

# Image generation (OpenAI images reuse AI_OPENAI_API_KEY)
AI_OPENAI_IMAGE_MODEL=gpt-image-1

# True only in local development/tests: routes every AI call to the mock provider.
REACH_AI_MOCK=false

# Publication connection key used by the blog/KB publisher (seeded by
# `php spark reach:pub-seed-connection`).
AICOUNTLY_PUBLICATION_CONNECTION_KEY=aicountly_com

# --- Fact-revision loop (Perplexity is the final authority) ---
# How many times the generating provider may revise rejected claims before
# the item parks for human review.
BLOG_FACT_REVISION_MAX_ATTEMPTS=2

# --- Cover images / media ---
# Public base URL of this Reach instance — signed cover-image URLs handed to
# aicountly.com are built on it (must resolve publicly, no redirects).
REACH_PUBLIC_BASE_URL=https://reach.aicountly.org
# 64+ random hex chars; signs public media URLs. Generate: openssl rand -hex 32
MEDIA_SIGNING_KEY=
# Rotation: days before a gallery cover may front another blog.
MEDIA_GALLERY_REUSE_COOLDOWN_DAYS=30
# Deficit horizon: covers needed for index entries in the next N days.
MEDIA_GALLERY_LOOKAHEAD_DAYS=14
# Superadmin address for the daily cover-deficit reminder (blank = no email).
BLOG_GALLERY_ALERT_EMAIL=

# --- Claude Code routine ingestion (v1/automation/*) ---
# 32+ random chars; the routine sends it as X-Automation-Token.
# Generate: openssl rand -hex 32
REACH_AUTOMATION_TOKEN=
# Optional override for the deployed content-base directory.
CONTENT_BASE_PATH=

# --- SEO Command Centre backlink provider (optional, paid) ---
# Leave blank to use the free internal-signals provider. Sign up at
# dataforseo.com for real backlink counts and add credentials here.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Knowledge Base (Claude-only route) ---
# Auto-approve + auto-publish routine KB drafts that pass the two-model rule.
KB_AUTO_APPROVE=false
# Real product screenshots via the Reach-local Playwright worker.
KB_SCREENSHOTS_ENABLED=false
KB_DEMO_EMAIL=
KB_DEMO_PASSWORD=

# --- Fact verification (fail-closed) ---
# An unavailable verifier never produces a pass.
BLOG_VERIFICATION_PASS_THRESHOLD=0.95
BLOG_AUTHORITATIVE_SOURCE_HOSTS=incometax.gov.in,gst.gov.in,mca.gov.in,rbi.org.in,sebi.gov.in,egazette.gov.in

# --- Daily roadmap optimiser (runs 00:30 Asia/Kolkata) ---
BLOG_ROADMAP_MIN_SCORE=40
BLOG_ROADMAP_MIN_SCORE_MOVEMENT=5
BLOG_ROADMAP_COOLDOWN_DAYS=14
BLOG_ROADMAP_MAX_DAILY_CANDIDATES=10
# Rolling 7-day ceiling on CREATE decisions. It must be >= the daily cap or one
# day of output consumes the whole week and the optimiser holds every candidate
# until the window rolls off — which looks exactly like "the cron stopped making
# blogs". Leave it unset to default to 7x the daily cap.
BLOG_ROADMAP_MAX_WEEKLY_PUBLICATIONS=70
BLOG_ROADMAP_PORTFOLIO_OVER_PCT_MARGIN=15
# Cold-start: discovered topics have no Search Console history. Without a floor
# they score ~0 and stay HOLD forever. Set false to require human pin / GSC data.
BLOG_ROADMAP_COLD_START_ENABLED=true
BLOG_ROADMAP_COLD_START_SCORE=55
# When the optimiser backlog is empty, auto-run DISCOVER_TOPICS from approved clusters.
BLOG_AUTO_DISCOVER_ON_OPTIMIZE=true

# --- Content sanitisation / SSRF policy ---
# Comma-separated hostnames that UrlPolicy will allow (in addition to public
# non-loopback/non-private addresses). Add explicit publishing/CDN hosts here.
URL_POLICY_ALLOWED_HOSTS=
