# Aicountly Reach Marketing Portal API (CodeIgniter 4.6)
# Copy to .env locally; never commit a real .env.
#
# This file lists only what an operator must SET: credentials, per-environment
# URLs, and the switches that are genuinely flipped. Everything else — cover
# relevance floors, roadmap thresholds, provider endpoints, model names,
# timeouts, verification thresholds — is policy and lives in code with a safe
# default. Those defaults are still overridable by adding the variable to a
# real .env; they are simply not knobs you need to think about on a fresh
# install.
#
# Full list, including every optional override and its built-in default:
#   docs/operations/REACH_ENV_REFERENCE.md
#
# Anything absent here is absent on purpose. Adding a variable back only to
# restate its default is how this file grew to 159 entries the first time.

CI_ENVIRONMENT=production
app.baseURL=https://reach.aicountly.org/api/
app.indexPage=

# --- PostgreSQL (Reach marketing DB — never target other portal DBs) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=aicountly_reach
DB_USER=
DB_PASS=

# --- Independent superadmin auth (Reach only; not linked to my.aicountly.com) ---
# Generate: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
JWT_SECRET=

# --- CORS — comma-separated origins allowed to call this API ---
ALLOWED_ORIGINS=https://reach.aicountly.org,http://localhost:5173

# --- Seed superadmin (InitialReachSeeder; quote values that contain spaces) ---
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME="Reach Superadmin"
SUPER_ADMIN_PASSWORD=

# --- Public identity ---
# REACH_APP_URL also backs the signed cover-image URLs handed to aicountly.com,
# so it must resolve publicly with no redirects.
REACH_APP_URL=https://reach.aicountly.org
# Apex, no www. aicountly.com 301s every www URL to the apex host — the public
# site's deploy asserts it — so www is only ever a redirect source. Setting it
# here put canonical URLs, analytics keys and search-metric lookups one hop away
# from the URLs the site serves and Google reports.
AICOUNTLY_SITE_URL=https://aicountly.com

# --- Console (SSO identity provider + audit/approval fan-out) ---
CONSOLE_API_URL=https://console.aicountly.org/api
CONSOLE_API_BASE_URL=https://console.aicountly.org/api
# Also used for staff roles: token refresh re-checks the caller's role via
# GET {CONSOLE_API_URL}/portal/controller-apps/user-access, so this Console
# service token needs capability `staff.roles` bound to app_code `reach`.
# REQUIRED IN PRODUCTION — without it a role removed in Console is only seen at
# the next sign-in. Console unreachable at refresh: allowed for 12h after the
# last confirmed sync, then refused.
# The same key (capability `audit.write`) sends Reach's central audit to
# POST {CONSOLE_API_URL}/portal/audit (CONSOLE_API_BASE_URL is read only when
# CONSOLE_API_URL is unset); cron `php spark reach:console-audit-deliver` every
# 5 minutes retries what Console could not take.
# The same key (capability `email.credentials`) reads Reach's email providers:
# GET {CONSOLE_API_URL}/portal/email/providers?app_code=reach (EmailProviderResolver).
CONSOLE_API_TOKEN=

# Console's Cron Job Monitor (console-react-app docs/CRON_MONITORS.md): the audit-deliver cron command reports
# each delivery run as monitor reach.console_audit_deliver with this key — the value Console's CRON_MONITOR_KEY /
# CRON_MONITOR_KEY_HASH accepts (else CONSOLE_SERVICE_KEY is tried). Unset: nothing is reported (the monitor
# reads OVERDUE); a failed report never fails the command. CONSOLE_API_BASE overrides the Console base
# (else CONSOLE_API_URL, else https://console.aicountly.org/api). Console's production refuses CONSOLE_SERVICE_KEY
# here. On the server the production deploy writes this line from the repository secret CONSOLE_CRON_MONITOR_KEY
# and schedules the command itself (bin/ops/jobs.txt).
CONSOLE_CRON_MONITOR_KEY=
# Console must send this value in the `X-Console-Token` header.
CONSOLE_INBOUND_TOKEN=

# --- Engage lead push (header `X-Portal-Token: <ENGAGE_INBOUND_TOKEN>`) ---
ENGAGE_API_BASE_URL=https://engage.aicountly.org/api/v1
ENGAGE_INBOUND_TOKEN=
# Engage → Reach lead outcomes (POST /api/v1/inbound/engage/lead-outcomes, header `X-Engage-Token`).
# Same value as Engage's outcome-sender token; >= 32 characters. Unset or shorter: the endpoint answers 503.
# docs/integrations/ENGAGE_OUTCOMES.md
REACH_INBOUND_ENGAGE_TOKEN=

# --- Playwright worker (degrades gracefully when unset) ---
WORKER_BASE_URL=https://worker.apis.aicountly.com
WORKER_API_TOKEN=

# --- aicountly.com publishing connector (environment only, never the DB) ---
AICOUNTLY_PUBLIC_SITE_BASE_URL=https://aicountly.com
AICOUNTLY_PUBLIC_SITE_SERVICE_TOKEN=
# HMAC-SHA256 secret for the request signature.
AICOUNTLY_PUBLIC_SITE_SIGNING_KEY=

# --- Reach-issued tokens ---
# Signs public media URLs. Generate: openssl rand -hex 32
# Serving fails closed without it: every cover 404s here and on aicountly.com.
MEDIA_SIGNING_KEY=

# Empty disables the public /v1/public/leads/capture route. Rotate periodically.
PUBLIC_LEAD_CAPTURE_TOKEN=

# --- Community answer generation ---
# Jurisdiction used when a question does not name one. Nothing sets a
# jurisdiction on agent-curated questions, so without this the prompt says
# "Jurisdiction:" with nothing after it and the model hedges every statutory
# answer ("thresholds can differ by jurisdiction") instead of answering.
#
# Empty by default on purpose: naming the jurisdiction changes what the model
# will assert about tax and company law, so it is an explicit decision. Set it
# to the jurisdiction your community actually serves, e.g. India.
COMMUNITY_DEFAULT_JURISDICTION=
# Claude Code routines send this as X-Automation-Token. openssl rand -hex 32
REACH_AUTOMATION_TOKEN=

# --- Cover image storage ---
# Absolute path, OUTSIDE the document root. Deploys rsync the API directory
# with --delete, so anything stored under it can be erased by a filter-rule
# mistake — which is how every uploaded cover was lost once already. Keep this
# alongside the blog_uploads convention, e.g. /home/<cpanel-user>/cover_images,
# and make sure the PHP user owns it. Blank stores under writable/uploads/.
MEDIA_STORAGE_PATH=

# --- AI provider keys (environment only, never the DB) ---
# A blank key keeps that adapter permanently inactive. OpenAI is the primary
# draft provider; Perplexity is the fact verifier and fails closed without it.
AI_OPENAI_API_KEY=
AI_GEMINI_API_KEY=
AI_PERPLEXITY_API_KEY=

# --- Reach Marketing Bot (mode lives in reach_bot_settings, not here) ---
REACH_BOT_OPENAI_KEY=
REACH_BOT_ANTHROPIC_KEY=

# --- Social channel tokens (empty = manual posting queue) ---
LINKEDIN_API_TOKEN=
TWITTER_API_TOKEN=
FACEBOOK_API_TOKEN=
INSTAGRAM_API_TOKEN=
YOUTUBE_API_TOKEN=
WHATSAPP_CHANNEL_API_TOKEN=

# --- GA4 traffic analytics (server api/.env only) ---
# Marketing site (aicountly.com)
GA4_PROPERTY_ID_MARKETING=
GOOGLE_SERVICE_ACCOUNT_JSON_MARKETING=
# Reach portal (reach.aicountly.org)
GA4_PROPERTY_ID_REACH=
GOOGLE_SERVICE_ACCOUNT_JSON_REACH=
# Shared my.aicountly.com SaaS hub property
GA4_PROPERTY_ID_SAAS=
GOOGLE_SERVICE_ACCOUNT_JSON_SAAS=
# Optional per-product override, one pair per slug in
# SaasProductTaxonomy::products() (server-php/app/Libraries/SaasProductTaxonomy.php).
# Falls back to the shared SAAS hub property above when unset. Required for
# products flagged in SaasProductTaxonomy::requiresDedicatedGa4Property()
# (currently auditor, smart_books, hrms, notes, pos — each lives on its own
# subdomain, so the shared hub property never sees their traffic at all).
# Naming: GA4_PROPERTY_ID_SAAS_{SLUG_UPPER} / GOOGLE_SERVICE_ACCOUNT_JSON_SAAS_{SLUG_UPPER},
# e.g. GA4_PROPERTY_ID_SAAS_AUDITOR, GA4_PROPERTY_ID_SAAS_OUR_PEOPLE,
# GA4_PROPERTY_ID_SAAS_MANAGE_ACCOUNT, GA4_PROPERTY_ID_SAAS_BUDDY.
#
# Use the numeric GA4 *property* ID here (GA4 Admin > Property Settings),
# NOT the data-stream ID and NOT the "G-XXXXXXXXXX" measurement ID shown on
# the stream's detail page — those are different values on the GA4 hierarchy
# (property -> data stream -> measurement ID) and the Data API this file
# feeds only accepts the property ID.
# notes.aicountly.com (GA4 stream id 15606101415, measurement id G-M6P7CN28X9)
GA4_PROPERTY_ID_SAAS_NOTES=
GOOGLE_SERVICE_ACCOUNT_JSON_SAAS_NOTES=
# pos.aicountly.com (GA4 stream id 15607107214, measurement id G-W3BCBLNYGR)
GA4_PROPERTY_ID_SAAS_POS=
GOOGLE_SERVICE_ACCOUNT_JSON_SAAS_POS=

# --- Google Search Console connector ---
SEARCH_CONSOLE_ENABLED=false
# Exact property string as it appears in Search Console,
# e.g. sc-domain:aicountly.com or https://aicountly.com/
SEARCH_CONSOLE_SITE_PROPERTY=
# Absolute path to the service-account JSON, readable by the web and CLI users
# and stored outside the document root. The account must be a property user.
SEARCH_CONSOLE_SERVICE_ACCOUNT_KEY_PATH=
# Search Console finalises data on a lag; never ingest days newer than this.
SEARCH_CONSOLE_DATA_LAG_DAYS=3
SEARCH_CONSOLE_TIMEOUT_SECONDS=30
# Force the mock connector even when credentials exist (local development only).
SEARCH_CONSOLE_USE_MOCK=false
#
# Two flags, two jobs:
#   SEARCH_CONSOLE_ENABLED       — arms the connector itself. Without it, the
#                                  ingest job skips and no facts are ever written.
#   BLOG_SEARCH_CONSOLE_ENABLED  — controls only whether the Blog Command Centre
#                                  Overview card reports live state (see below).
# Set both. Then verify with:  php spark reach:search-console doctor

# --- Per-content analytics (GA4) ---
CONTENT_ANALYTICS_ENABLED=false
# Numeric GA4 property ID, not "G-XXXX".
CONTENT_ANALYTICS_PROPERTY_ID=
CONTENT_ANALYTICS_SERVICE_ACCOUNT_KEY_PATH=

# --- IndexNow ---
INDEXNOW_ENABLED=false
# Key reference — never commit the actual key.
INDEXNOW_KEY_REFERENCE=

# --- Campaign distribution gateways ---
# Email — providers are managed centrally in Console (Email providers, bound to
# `reach`) and read with CONSOLE_API_TOKEN; the answer is cached for its TTL in an
# encrypted 0600 file (EMAIL_PROVIDER_CACHE_DIR, default writable/cache/email-providers)
# and used up to 15 min stale while Console is down. Normal send: primary then
# fallback; a resend (explicit re-send of an attempted daily report): fallback first.
# EMAIL_API_KEY / EMAIL_API_URL / EMAIL_API_FORMAT below are only the LAST RESORT,
# used when Console has no provider for reach or cannot be reached with nothing cached.
# Check: php spark reach:email-providers [--refresh] [--send=you@example.com] [--resend]
EMAIL_API_KEY=
# EMAIL_API_URL=https://e.api.itwalk.in/email/1/send
# EMAIL_API_FORMAT=auto      # auto | multipart | json
# EMAIL_PROVIDER_CACHE_DIR=
# SMS (Digimiles / AOC Portal). SMS_SENDER_ID is required for sending, and
# SKIP_SEND defaults to true — both channels stay dark until set false.
SMS_API_KEY=
SMS_SENDER_ID=AICTLY
SMS_SKIP_SEND=true
# WhatsApp (Infobip-style)
WHATSAPP_API_KEY=
WHATSAPP_WABA_ID=
WHATSAPP_SENDER_ID=
WHATSAPP_SKIP_SEND=true

# --- SEO backlinks (optional, paid) ---
# Blank uses the free internal-signals provider.
DATAFORSEO_LOGIN=

# --- Network / SSRF policy ---
# Comma-separated IPs. When the immediate peer matches, RateLimitFilter trusts
# the first X-Forwarded-For entry. Leave empty on cPanel.
TRUSTED_PROXIES=
# Extra hostnames UrlPolicy may fetch, beyond public non-private addresses.
URL_POLICY_ALLOWED_HOSTS=

# --- Blog automation switches ---
# The pipeline is off by default; turn these on deliberately, in this order.
BLOG_AUTOMATION_ENABLED=false
BLOG_AI_GENERATION_ENABLED=false
BLOG_FACT_VERIFICATION_ENABLED=false
BLOG_ROADMAP_OPTIMIZER_ENABLED=false
# Paid AI cover generation (OpenAI/Gemini image APIs — billed outside any
# Claude subscription). The curated gallery is assigned regardless of this
# flag; it only decides whether a gallery miss may spend on an image. A blog
# with no suitable cover is parked for review either way.
#
# These three also gate the Claude-routine blogs, where Settings → AI &
# Automation decides (on by default) and an EXPLICIT false here is a hard
# kill-switch. Leave them commented out unless you mean "off for routines too":
# the API pipeline above treats unset as off anyway.
# BLOG_IMAGE_GENERATION_ENABLED=false
# BLOG_PUBLIC_PUBLISHER_ENABLED=false
# BLOG_AUTO_PUBLISH_ENABLED=false
# Send old→new 301s in the publication payload (`redirects` key) so a post that
# changed slug keeps its previous URL working. Off by default: whether the
# public site understands that key belongs to a different codebase, and a
# strict receiver would reject every publish. Verify with one post —
# `reach:blog-url-drift --probe` before and after — then enable.
BLOG_PUBLISH_REDIRECTS_ENABLED=false
# Blog Command Centre → Overview → Search card. This flag alone does NOT ingest
# anything: set SEARCH_CONSOLE_ENABLED above as well, or the card will report
# CONNECTED while the fact table stays empty.
BLOG_SEARCH_CONSOLE_ENABLED=false
BLOG_GA4_ENABLED=false

# --- Blog / KB operations ---
# Superadmin address for the daily cover-deficit reminder (blank = no email).
# The gallery feeds every routine blog, so a deficit stops publication.
BLOG_GALLERY_ALERT_EMAIL=
# Routine KB drafts are vetted by Gemini and auto-published when it approves
# (Settings → AI & Automation). KB_AUTO_APPROVE is no longer read for them.
# KB_AUTO_PUBLISH_ENABLED=false is a hard kill-switch for that auto-publish.
# KB_AUTO_PUBLISH_ENABLED=false

# Optional: key material for secrets saved in Settings → AI & Automation
# (falls back to JWT_SECRET). AI keys below are fallbacks once a key is saved in the UI.
# REACH_SETTINGS_KEY=

# ── Automated video (Stream V) ────────────────────────────────────────────────
# Keys can instead be saved in Reach → Settings → AI & Automation → Video
# (encrypted); these env values are only the fallback.
# SHOTSTACK_API_KEY=
# SHOTSTACK_ENV=stage            # stage (watermarked) | v1 (production)
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=         # normally set by "Connect YouTube channel"
# VIDEO_TTS_MODEL=gpt-4o-mini-tts
# VIDEO_TTS_VOICE=coral
# Voice-overs/stills the renderer fetches; keep outside the deploy tree.
# VIDEO_MEDIA_STORAGE_PATH=/home/<user>/reach_video_media
# Development only — mocks refuse to run in production:
# VIDEO_PIPELINE_MOCKS=0
