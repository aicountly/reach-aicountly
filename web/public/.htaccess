RewriteEngine On
RewriteBase /

# Serve every text response as UTF-8. A Content-Type charset from the server
# overrides the <meta charset> in index.html, so a cPanel default of
# ISO-8859-1 would render the portal's punctuation as mojibake.
AddDefaultCharset utf-8

# API: never serve the SPA for /api/* — Apache must handle the api/ folder
RewriteRule ^api(?:/|$) - [L]

# SPA fallback — every other unmatched URL is served by index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

# Long-cache the hashed asset bundle
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|jpeg|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# --- Security headers (security audit, Oct 2026) ------------------------------
# Framing only by this site, no MIME sniffing, no full referrer to other origins, no
# powerful browser features, HSTS on HTTPS. The CSP only pins framing / base / plugins
# so the Vite bundle keeps working unchanged.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# Never serve dotfiles (.env, .git …) from the document root; .well-known stays reachable.
RedirectMatch 404 /\.(?!well-known)
