# cPanel api/ rsync filters (use: rsync --filter='merge scripts/cpanel-rsync-api.filters')
#
# PRODUCTION RULE: api/.env on the server is never uploaded, overwritten, or deleted by deploy.
#
# - .env     do not copy from CI (secrets live only on the server)
# P .env     never delete the server's .env when using --delete
#
# .env.example is NOT listed — it is deployed from git on every release.

P .env
- .env

# Preserve server runtime data across --delete deploys.
#
# The trailing /*** is load-bearing. rsync matches every path it is about to
# delete against these rules individually, and "writable/uploads/" matches only
# the directory entry — not writable/uploads/media/covers/2026/08/x.webp, which
# was therefore deleted on every deploy while the directory itself survived.
# That left gallery rows in the database pointing at binaries that no longer
# existed: covers 404'd in the console and on aicountly.com. "dir/***" is the
# documented idiom for "this directory and everything inside it".
P writable/.reach_seed_complete
P writable/cache/***
P writable/logs/***
P writable/session/***
P writable/uploads/***

# Never ship test code or PHPUnit config to the server: under api/ they are
# web-reachable, and a request for a .php file runs it against the live .env.
# H (hide) acts on the sender only, so --delete also removes the copy an
# earlier deploy left in api/ (a "-" exclude would protect it forever).
H /tests/
H /phpunit.xml.dist
H /phpunit.xml
