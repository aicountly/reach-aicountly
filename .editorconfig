# Keeps every editor writing UTF-8 without a BOM. A CP437/CP1252 round-trip of
# these files is what turned "Live GA4 data — All sites" into mojibake on the
# analytics page; `npm run check:encoding` (web/) fails the build if it recurs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,json,css,html,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.php]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
